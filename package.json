{
  "name": "prproof",
  "version": "1.0.0",
  "description": "Verify that regression tests actually prove a pull request fixes the reported bug.",
  "main": "./dist/cli/cli.js",
  "type": "module",
  "bin": {
    "prproof": "./dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/cli.ts",
    "test": "vitest run",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "testing",
    "regression",
    "verification",
    "pull-request",
    "ci"
  ],
  "author": "Pedro Navajas",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}